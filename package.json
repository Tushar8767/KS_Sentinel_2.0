{
  "name": "ks-sentinel-2.0",
  "version": "2.0.0",
  "private": true,
  "description": "KS Sentinel 2.0 — Web-based Virtual Operating Environment",
  "workspaces": [
    "client",
    "server",
    "agent"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node scripts/start-dev.js",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:agent": "npm --prefix agent run dev",
    "agent": "npm --prefix agent start",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "node --check server/src/index.js",
    "test": "node --test tests/server/*.test.js agent/tests/*.test.js",
    "git:repair": "node scripts/repair-index.js"
  },
  "keywords": [
    "virtual-os",
    "security-gateway",
    "sentinel",
    "control-plane"
  ],
  "author": "",
  "license": "ISC"
}
